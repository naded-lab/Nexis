diff --git a/nexis-android/app/src/main/res/values/styles.xml b/nexis-android/app/src/main/res/values/styles.xml
index 78842ef..5914b33 100644
--- a/nexis-android/app/src/main/res/values/styles.xml
+++ b/nexis-android/app/src/main/res/values/styles.xml
@@ -4,4 +4,18 @@
         <item name="android:colorPrimary">@color/nexis_teal</item>
         <item name="android:windowBackground">@color/white</item>
     </style>
+
+    <!--
+        Launch theme: applied to the Activity for the brief window between
+        process start and the first Compose frame. Paints the brand teal +
+        the logo immediately via the OS-level SplashScreen API instead of
+        the plain white android:windowBackground default — this is what was
+        reading as a long "white screen" on cold start. Switches to
+        Theme.Nexis the instant setContent()'s first frame is ready.
+    -->
+    <style name="Theme.Nexis.Splash" parent="Theme.SplashScreen">
+        <item name="windowSplashScreenBackground">@color/nexis_teal</item>
+        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nexis_logo</item>
+        <item name="postSplashScreenTheme">@style/Theme.Nexis</item>
+    </style>
 </resources>
